# Database (use Supabase "Session mode" / direct URI for Prisma migrate; pooler for serverless if needed)
# https://supabase.com/docs/guides/database/connecting-to-postgres
POSTGRES_USER=vineroot
POSTGRES_PASSWORD=vineroot
POSTGRES_DB=vineroot
DATABASE_URL=postgresql://vineroot:vineroot@localhost:5433/vineroot

# Supabase (same Postgres as DATABASE_URL when using Supabase-hosted DB)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ModelT PM orchestrator API (Section 5.3) — Bearer token for Nest routes under /api/v1/pm/*
PM_ORCHESTRATOR_SECRET=change-me-long-random-secret
# PM Agent Crew (Section 5.5): only runs when set to exactly "true", after PM migrations exist
# PM_CREW_ENABLED=true

# Configurable crons (standard 5-field expressions). Set CRON_JOBS_ENABLED=false to disable all registrations below.
# CRON_JOBS_ENABLED=false
# Periodic goal metric recomputation (opt-in; unset = off). Overlapping ticks coalesce to one run.
# CRON_GOAL_METRICS=0 * * * *
# Attachment retention purge (default 03:00 daily when unset; empty = off)
# CRON_ATTACHMENT_RETENTION=0 3 * * *
# CRON_ATTACHMENT_RETENTION=
# PM crew schedules (defaults match previous @Cron behavior; empty = off)
# CRON_PM_CREW_HEARTBEAT=*/5 * * * *
# CRON_PM_CREW_PROGRESS=0 * * * *

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-with-strong-random-secret
JWT_REFRESH_SECRET=change-me-refresh-in-production-with-strong-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=4000
NODE_ENV=development
# Optional: used in SLACK_NOTIFY / automation templates for {link} (e.g. http://localhost:3000)
# APP_PUBLIC_URL=http://localhost:3000

# Attachments (local disk by default). Set S3_BUCKET (+ AWS creds) to store uploads in S3-compatible blob storage.
# UPLOAD_ROOT=./uploads
# ATTACHMENT_RETENTION_DAYS=0
# ATTACHMENT_ALLOW_EXECUTABLES=0
# ATTACHMENT_UPLOAD_NOTIFY_URL=
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=1
# ATTACHMENT_S3_PRESIGN_SECONDS=300

# Public project intake forms: optional Google reCAPTCHA (v3 recommended). When INTAKE_RECAPTCHA_SECRET is set, submit requires captchaToken.
# INTAKE_RECAPTCHA_SITE_KEY=
# INTAKE_RECAPTCHA_SECRET=

# Frontend (legacy; Vite apps use VITE_* in apps/web/.env)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
