// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
  ESCALATION_PENDING
  BLOCKED_AWAITING_HUMAN
  BLOCKED_HUMAN_REROUTE
  REROUTED_READY
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectColor {
  RED
  ORANGE
  YELLOW
  GREEN
  TEAL
  BLUE
  INDIGO
  PURPLE
  PINK
  GRAY
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum ActorTier {
  HUMAN
  CLAUDE_SONNET
  CLAUDE_OPUS
  CURSOR_COMPOSER
  CREW_UIUX
  CREW_BACKEND
  CREW_QA
  CREW_DEVOPS
  CREW_INFRA
  CREW_DATA
  CREW_PLANNING
  CREW_LIBRARY
  UNASSIGNED
}

enum TaskDomain {
  UIUX
  BACKEND
  INFRA
  DATA
  TESTING
  DEVOPS
  PLANNING
  REVIEW
  LIBRARY
  GENERAL
}

enum TaskComplexity {
  TRIVIAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewGate {
  NONE
  AUTOMATED_ONLY
  CRITIC_REVIEW
  HUMAN_SIGNOFF
  FULL
}

enum DependencyType {
  BLOCKING
  WAITING_ON
}

/// CPM link type (Microsoft Project FS/SS/FF/SF). Drives schedule engine; legacy deps default to FS.
enum ScheduleLinkType {
  FS
  SS
  FF
  SF
}

/// Task schedule constraint (MSP-style).
enum TaskConstraintType {
  ASAP
  ALAP
  SNET
  SNLT
  MSO
  MFO
}

/// Fixed-units / fixed-work / fixed-duration; MANUAL = engine does not move dates unless user clears manual flag per task.
enum TaskScheduleMode {
  MANUAL
  FIXED_UNITS
  FIXED_WORK
  FIXED_DURATION
}

/// MS Project–style work distribution for timephased grids only (CPM unchanged).
enum TaskWorkContour {
  FLAT
  FRONT_LOADED
  BACK_LOADED
  BELL
  DOUBLE_PEAK
  TURTLE
  EARLY_PEAK
  LATE_PEAK
}

/// Scrum/Kanban-style work classification (epics often use parentTaskId for children).
enum TaskWorkItemType {
  TASK
  STORY
  BUG
  EPIC
  CHORE
  SPIKE
}

enum SprintState {
  PLANNED
  ACTIVE
  CLOSED
}

/// Board column WIP: OFF = display only; WARN = confirm in UI when over; STRICT = API blocks moves/creates over limit.
enum KanbanWipEnforcement {
  OFF
  WARN
  STRICT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  MULTI_SELECT
  PERSON
  URL
}

/// Stored on CustomFieldDefinition — NONE = user-editable; SUBTASK_ROLLUP_NUMBER = read-only aggregate over descendant tasks.
enum CustomFieldComputedKind {
  NONE
  SUBTASK_ROLLUP_NUMBER
}

enum CustomFieldRollupAggregation {
  SUM
  AVG
  MIN
  MAX
  COUNT
}

enum GoalMetricType {
  PERCENT
  NUMBER
  CURRENCY
  BOOLEAN
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  MISSED
  NO_STATUS
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_COMPLETED
  TASK_DUE_SOON
  TASK_OVERDUE
  PROJECT_INVITE
  MENTION
  RULE_TRIGGERED
  AGENT_ACTION
  ESCALATION
}

enum AutomationTriggerType {
  TASK_STATUS_CHANGED
  TASK_CREATED
  TASK_DUE_DATE_APPROACHING
  TASK_OVERDUE
  TASK_COMPLETED
  ASSIGNEE_CHANGED
  CUSTOM_FIELD_CHANGED
  SECTION_CHANGED
  AGENT_COMPLETED
}

enum AutomationActionType {
  CHANGE_STATUS
  ASSIGN_TO
  MOVE_TO_SECTION
  ADD_TAG
  REMOVE_TAG
  NOTIFY_USER
  SET_PRIORITY
  SET_DUE_DATE
  TRIGGER_AGENT
  CREATE_SUBTASK
  POST_WEBHOOK
  SLACK_NOTIFY
}

enum AuditEventType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_ASSIGNED
  STATUS_CHANGED
  ESCALATION
  AGENT_STARTED
  AGENT_COMPLETED
  AGENT_FAILED
  REROUTED
  HUMAN_SIGNOFF
  COMMENT_ADDED
  ATTACHMENT_ADDED
  RULE_TRIGGERED
}

enum AgentTokenScope {
  READ_TASKS
  WRITE_TASKS
  READ_PROJECTS
  WRITE_PROJECTS
  FULL_ACCESS
}

// ─── CORE USER & AUTH ─────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  isAgent       Boolean  @default(false)
  agentTier     ActorTier?
  timezone      String   @default("UTC")
  /// Optional override calendar for workload / leveling (CPM uses project calendar first).
  workCalendarId String?
  /// Default cost rate for EVM when assigned to tasks (per hour).
  resourceStandardRatePerHour   Decimal? @db.Decimal(14, 4)
  resourceOvertimeRatePerHour   Decimal? @db.Decimal(14, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  workCalendar WorkCalendar? @relation("UserWorkCalendar", fields: [workCalendarId], references: [id], onDelete: SetNull)

  workspaceMembers   WorkspaceMember[]
  teamMembers        TeamMember[]
  projectMembers     ProjectMember[]
  createdTasks       Task[]            @relation("TaskCreator")
  assignedTasks      TaskAssignee[]
  createdProjects    Project[]
  comments           Comment[]
  notifications      Notification[]    @relation("NotifRecipient")
  sentNotifications  Notification[]    @relation("NotifSender")
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]
  agentTokens        AgentToken[]
  refreshTokens      RefreshToken[]
  goals              Goal[]
  createdDashboards  Dashboard[]
  reportingSavedViews ReportingSavedView[]
  projectSavedViews  ProjectSavedView[]
  commentMentions    CommentMention[]
  taskCostEntriesCreated TaskCostEntry[] @relation("TaskCostEntryCreator")
  intakeFormsCreated ProjectIntakeForm[] @relation("IntakeFormCreator")

  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── WORKSPACE ────────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  /// Optional Slack Incoming Webhook URL (workspace admin only); not exposed in API responses.
  slackIncomingWebhookUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members     WorkspaceMember[]
  teams       Team[]
  projectLinks ProjectWorkspace[]
  tags        Tag[]
  customFields CustomFieldDefinition[]
  portfolios  Portfolio[]
  goals       Goal[]
  automations Automation[]
  auditLogs   AuditLog[]
  agentTokens AgentToken[]
  dashboards  Dashboard[]
  outboundWebhooks WorkspaceOutboundWebhook[]
  reportingSavedViews ReportingSavedView[]
  workCalendars   WorkCalendar[]
  schedulePrograms ScheduleProgram[]
  genericResources GenericResource[]

  @@index([slug])
  @@index([deletedAt])
}

/// Working-time calendar for CPM (weekly pattern + exceptions). Lag on dependencies counts in working days when a calendar is set.
model WorkCalendar {
  id            String   @id @default(cuid())
  workspaceId String
  name        String
  timeZone    String   @default("UTC")
  /// JSON: { "mon"|"tue"|... }: minutes per day (0 = non-working). Default seed: Mon–Fri 480.
  weeklyPattern Json   @default("{\"mon\":480,\"tue\":480,\"wed\":480,\"thu\":480,\"fri\":480,\"sat\":0,\"sun\":0}")
  /// JSON: [{ "date": "YYYY-MM-DD", "workingMinutes": number }]
  exceptions  Json     @default("[]")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  users     User[]    @relation("UserWorkCalendar")
  tasks     Task[]    @relation("TaskWorkCalendar")
  genericResources GenericResource[] @relation("GenericResourceWorkCalendar")

  @@index([workspaceId])
}

/// Named non-user resource (equipment, role bucket) for MSP-style assignments and leveling buckets.
model GenericResource {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  /// Max simultaneous allocation % across tasks in a period (default 100 = one unit).
  maxUnitsPercent  Float    @default(100)
  /// Optional standard cost rate per hour for EVM / roll-up (same currency as user rates).
  standardRatePerHour Decimal? @db.Decimal(14, 4)
  /// Optional resource calendar for capacity (intersected with project calendar in overload math).
  workCalendarId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workCalendar WorkCalendar? @relation("GenericResourceWorkCalendar", fields: [workCalendarId], references: [id], onDelete: SetNull)
  assignments  TaskGenericResourceAssignment[]

  @@index([workspaceId])
  @@index([workCalendarId])
}

/// Program container for cross-project dependencies and portfolio schedule roll-up (same workspace).
model ScheduleProgram {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  ScheduleProgramProject[]

  @@index([workspaceId])
}

model ScheduleProgramProject {
  id        String   @id @default(cuid())
  programId String
  projectId String
  createdAt DateTime @default(now())

  program ScheduleProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([programId, projectId])
  @@index([projectId])
}

/// Outbound HTTPS webhooks (signed) for external integrations; event filter aligns with AutomationTriggerType values.
model WorkspaceOutboundWebhook {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  url         String
  /// HMAC-SHA256 secret (server-only); shown once on create.
  secret      String
  /// JSON string[] of AutomationTriggerType; empty array = all supported outbound events.
  eventTypes  Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Saved filter presets for the workspace Reporting tab (JSON matches WorkspaceReportingFilters).
model ReportingSavedView {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  sortOrder   Int      @default(0)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── DASHBOARD (Asana-style reporting; extensible for agents via layoutMeta + widget config)

model Dashboard {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Agent / automation hints: filter presets, layout version, pinned queries (JSON).
  layoutMeta  Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
  widgets   DashboardWidget[]

  @@index([workspaceId])
}

model DashboardWidget {
  id          String   @id @default(cuid())
  dashboardId String
  /// TASKS_BY_STATUS | PROJECT_SUMMARY | PROJECT_CFD | PROJECT_EVM | PORTFOLIO_ACTIVE_SPRINTS | PORTFOLIO_SPRINT_VELOCITY | NUMBER_METRIC | AGENT_SLOT | TEXT_NOTE
  type        String
  title       String
  sortOrder   Int      @default(0)
  gridX       Int      @default(0)
  gridY       Int      @default(0)
  gridW       Int      @default(4)
  gridH       Int      @default(2)
  /// projectId, portfolioId, value, body, agentSlotKey, etc.
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── TEAM ─────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  emoji       String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  projects    Project[]

  @@index([workspaceId])
  @@index([deletedAt])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  teamId      String?
  createdById String
  name        String
  description String?
  color       ProjectColor  @default(BLUE)
  emoji       String?
  status      ProjectStatus @default(ACTIVE)
  isPrivate   Boolean       @default(false)
  isArchived  Boolean       @default(false)
  /// Blueprint project; hidden from default workspace lists unless explicitly requested.
  isTemplate  Boolean       @default(false)
  startDate   DateTime?
  dueDate     DateTime?
  defaultView String        @default("list")
  sortOrder   Int           @default(0)
  kanbanWipEnforcement KanbanWipEnforcement @default(OFF)
  /// CPM: project working calendar; null = 8h Mon–Fri synthetic calendar.
  workCalendarId       String?
  /// New tasks default to manual schedule unless false (then engine can set dates).
  defaultManualSchedule Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  team        Team?          @relation(fields: [teamId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  workCalendar WorkCalendar? @relation(fields: [workCalendarId], references: [id], onDelete: SetNull)
  workspaceLinks ProjectWorkspace[]
  members     ProjectMember[]
  sections    Section[]
  sprints     Sprint[]
  tasks       Task[]
  portfolioItems PortfolioItem[]
  customFieldDefs ProjectCustomField[]
  activityLogs ActivityLog[]
  cfdSnapshots ProjectCfdSnapshot[]
  savedViews   ProjectSavedView[]
  intakeForm   ProjectIntakeForm?
  scheduleProgramMemberships ScheduleProgramProject[]

  @@index([teamId])
  @@index([deletedAt])
  @@index([workCalendarId])
}

model Sprint {
  id        String      @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  state     SprintState @default(PLANNED)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  metricSnapshots SprintMetricSnapshot[]

  @@index([projectId])
}

/// End-of-day task counts by status for cumulative flow (CFD); keyed by project + calendar day.
model ProjectCfdSnapshot {
  id        String   @id @default(cuid())
  projectId String
  day       DateTime @db.Date
  /// JSON map TaskStatus -> count (non-deleted, non-template tasks in project).
  byStatus  Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, day])
  @@index([projectId, day])
}

/// Per-sprint burndown/burnup-friendly metrics at end of calendar day (when tasks change).
model SprintMetricSnapshot {
  id                  String   @id @default(cuid())
  sprintId            String
  day                 DateTime @db.Date
  remainingPoints     Float
  scopePoints         Float
  completedCumulative Float
  createdAt           DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, day])
  @@index([sprintId, day])
}

/// Named list/board filter presets for a project (sprint, epic, roots-only, optional target tab).
model ProjectSavedView {
  id          String   @id @default(cuid())
  projectId   String
  createdById String
  name        String
  config      Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId])
}

model ProjectWorkspace {
  projectId   String
  workspaceId String
  joinedAt    DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([projectId, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(EDITOR)
  joinedAt  DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ─── SECTION ──────────────────────────────────────────────────────────────────

model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String?
  sortOrder Int      @default(0)
  /// Max root-level tasks in this column on the board; null = unlimited.
  wipLimit  Int?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  intakeFormsTarget ProjectIntakeForm[]

  @@index([projectId])
}

/// One intake form per project: public link creates tasks in `targetSectionId`.
model ProjectIntakeForm {
  id          String  @id @default(cuid())
  projectId String  @unique
  createdById String
  name        String  @default("Intake")
  description String?
  isPublished Boolean @default(false)
  /// Opaque token for unauthenticated GET/submit; set on first publish.
  publicToken     String? @unique
  targetSectionId String
  /// JSON array: ProjectIntakeFormFieldDto
  fields          Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("IntakeFormCreator", fields: [createdById], references: [id])
  section   Section @relation(fields: [targetSectionId], references: [id], onDelete: Restrict)

  @@index([publicToken])
}

// ─── TASK ─────────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  workspaceId  String?
  projectId    String?
  sectionId    String?
  parentTaskId String?
  createdById  String

  title        String
  description  String?
  htmlContent  String?
  workItemType TaskWorkItemType @default(TASK)
  storyPoints  Float?
  sprintId     String?
  status       TaskStatus   @default(BACKLOG)
  priority     TaskPriority @default(NONE)
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  estimatedMin Int?
  actualMin    Int?

  sortOrder    Int          @default(0)
  /// Lower = earlier when viewing backlog; only used for tasks with no sprint. Cleared on sprint assignment.
  backlogRank  Int?
  boardColumn  String?

  actorTier    ActorTier    @default(UNASSIGNED)
  domain       TaskDomain   @default(GENERAL)
  complexity   TaskComplexity @default(LOW)
  reviewGate   ReviewGate   @default(NONE)
  phase        Int?
  parallelGroup String?
  agentContext Json?
  agentOutput  Json?
  agentStartedAt DateTime?
  agentCompletedAt DateTime?
  retryCount   Int          @default(0)
  escalationNote String?

  isArchived   Boolean      @default(false)
  /// RFC 5545 RRULE line without DTSTART (e.g. FREQ=WEEKLY;INTERVAL=1;BYDAY=MO). Next instance uses due/start as anchor.
  recurrenceRule   String?
  recurrenceUntil  DateTime?
  /// Task blueprint; excluded from list/board counts and section task lists by default.
  isTemplate   Boolean      @default(false)
  /// Timeline / planning: render as milestone (diamond) instead of a bar span.
  isMilestone  Boolean      @default(false)
  /// When false, schedule recalculation may update startDate/dueDate from CPM.
  isManuallyScheduled Boolean @default(true)
  constraintType      TaskConstraintType @default(ASAP)
  constraintDate      DateTime?
  deadlineDate        DateTime?
  /// Working-time duration for CPM (minutes). Null = infer from start/due or default one working day.
  durationWorkingMinutes Int?
  /// Total work (minutes) for fixed-work mode / EVM.
  workMinutes         Int?
  scheduleMode        TaskScheduleMode @default(MANUAL)
  /// When true, fixed-work style duration shrinks as assignment units increase (MSP-style).
  effortDriven        Boolean      @default(false)
  /// Summary bar: dates roll up from direct subtasks on recalculate (min start / max finish).
  isSummaryRollup     Boolean      @default(false)
  /// MSP-style leveling priority (0–1000); lower values are delayed first when leveling. Default 500.
  levelingPriority    Int          @default(500)
  /// Working days this task was pushed by resource leveling (accumulated).
  levelingDelayWorkingDays Int     @default(0)
  /// When true, leveling may split this task once split-aware leveling exists; ordering hint today.
  levelingCanSplit    Boolean      @default(false)
  /// Optional task calendar; else first assignee user calendar, else project/workspace default.
  workCalendarId      String?
  /// 0–100 for EVM and tracking.
  percentComplete     Float        @default(0)
  /// Phase 7: optional split-task / contour segments for display (JSON array of { start, end, workMinutes? } ISO datetimes). CPM ignores; timeline draws multiple bars.
  scheduleSegments    Json?
  /// How work (and proportional cost) is spread across periods in GET …/schedule/timephased when there are no scheduleSegments; segments override contour.
  workContour         TaskWorkContour @default(FLAT)
  /// One-off task cost (currency units); stacks with labor / per-use assignment costs for BAC.
  fixedCost           Decimal?     @db.Decimal(14, 4)
  /// Overtime labor minutes (actuals); split across assignees by work share for OT rate in BAC/labor cost.
  overtimeWorkMinutes Int?
  /// When true, task is a budget / cap line for reporting; excluded from operating EVM totals (see budget rollup on GET …/evm).
  isBudgetTask        Boolean      @default(false)
  /// Recorded actual cost for EVM (AC). When null, AC defaults to EV at task level.
  actualCost          Decimal?     @db.Decimal(14, 4)
  syncVersion  Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  project      Project?     @relation(fields: [projectId], references: [id])
  workCalendar WorkCalendar? @relation("TaskWorkCalendar", fields: [workCalendarId], references: [id], onDelete: SetNull)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  section      Section?     @relation(fields: [sectionId], references: [id])
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]       @relation("Subtasks")
  /// Optional link to an EPIC task in the same project (cross-parent epic membership).
  epicTaskId   String?
  epicTask     Task?        @relation("TaskEpicLink", fields: [epicTaskId], references: [id], onDelete: SetNull)
  tasksInEpic  Task[]       @relation("TaskEpicLink")
  assignees    TaskAssignee[]
  genericResourceAssignments TaskGenericResourceAssignment[]
  dependencies TaskDependency[] @relation("DependentTask")
  blockedBy    TaskDependency[] @relation("BlockingTask")
  tags         TaskTag[]
  comments     Comment[]
  attachments  Attachment[]
  customFieldValues CustomFieldValue[]
  activityLogs ActivityLog[]
  auditLogs    AuditLog[]
  baselines    TaskBaseline[]
  costEntries  TaskCostEntry[]

  @@index([projectId])
  @@index([sectionId])
  @@index([parentTaskId])
  @@index([workCalendarId])
  @@index([status])
  @@index([dueDate])
  @@index([actorTier])
  @@index([deletedAt])
  @@index([sprintId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  /// 1–100: allocation % for leveling / workload (MSP-style units).
  unitsPercent Float  @default(100)
  /// Optional assignment-level work (minutes); when set, cost/EVM uses this instead of task work × units.
  workMinutes Int?
  /// One-time fee per assignment row (e.g. per-use), added to task BAC / baseline cost.
  costPerUse  Decimal? @db.Decimal(14, 4)
  assignedAt DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskGenericResourceAssignment {
  id                String   @id @default(cuid())
  taskId            String
  genericResourceId String
  unitsPercent      Float    @default(100)
  /// One-time per-assignment fee (e.g. equipment per-use), added to task BAC / baseline cost.
  costPerUse        Decimal? @db.Decimal(14, 4)
  assignedAt        DateTime @default(now())

  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  genericResource GenericResource @relation(fields: [genericResourceId], references: [id], onDelete: Cascade)

  @@unique([taskId, genericResourceId])
  @@index([taskId])
  @@index([genericResourceId])
}

model TaskDependency {
  id            String         @id @default(cuid())
  dependentId   String
  blockingId    String
  type          DependencyType @default(WAITING_ON)
  /// CPM link type; FS matches legacy finish-to-start semantics.
  linkType      ScheduleLinkType @default(FS)
  /// Working-day lag when project has WorkCalendar; else treated as calendar-day offset (legacy).
  lagDays       Int            @default(0)
  /// When true, lagDays counts calendar days in the successor time zone (MSP elapsed lag).
  lagIsElapsed  Boolean        @default(false)
  createdAt     DateTime       @default(now())

  dependentTask Task @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  blockingTask  Task @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)

  @@unique([dependentId, blockingId])
  @@index([dependentId])
  @@index([blockingId])
}

/// Optional cost ledger lines for a task; summed into EVM AC when `actualCost` is unset.
model TaskCostEntry {
  id            String   @id @default(cuid())
  taskId        String
  amount        Decimal  @db.Decimal(14, 4)
  description   String?
  entryDate     DateTime @default(now())
  createdAt     DateTime @default(now())
  createdById   String?

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskCostEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

/// Saved baseline snapshots per task (indices 0–10; MSP-style multi-baseline).
model TaskBaseline {
  id                  String   @id @default(cuid())
  taskId              String
  baselineIndex       Int
  baselineStart       DateTime?
  baselineFinish      DateTime?
  baselineWorkMinutes Int?
  baselineCost         Decimal?  @db.Decimal(14, 4)
  createdAt           DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, baselineIndex])
  @@index([taskId])
}

// ─── COMMENT ──────────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  /// Top-level comment when null; reply when set (same task as parent).
  parentCommentId String?
  body      String
  htmlBody  String?
  isAgentComment Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies   Comment[] @relation("CommentReplies")
  mentions  CommentMention[]

  @@index([taskId])
  @@index([authorId])
  @@index([parentCommentId])
}

/// @mention targets persisted for notifications and display.
model CommentMention {
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

// ─── ATTACHMENT ───────────────────────────────────────────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String?
  filename     String
  mimeType     String
  sizeBytes    Int
  url          String
  storageKey   String
  createdAt    DateTime @default(now())

  task         Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── TAG ──────────────────────────────────────────────────────────────────────

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6B7280")
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskTags    TaskTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TaskTag {
  taskId String
  tagId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

// ─── CUSTOM FIELDS ────────────────────────────────────────────────────────────

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  type        CustomFieldType
  options     Json?
  isRequired  Boolean         @default(false)
  /// Admin-facing notes (shown in field picker / settings).
  description String?
  /// Default JSON payload for this field (UI + future task-create application).
  defaultValue Json?
  computedKind CustomFieldComputedKind @default(NONE)
  /// For SUBTASK_ROLLUP_NUMBER: workspace NUMBER field to aggregate from descendant tasks.
  rollupSourceFieldId String?
  rollupAggregation   CustomFieldRollupAggregation?
  createdAt   DateTime        @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectDefs ProjectCustomField[]
  values      CustomFieldValue[]
  rollupSourceField CustomFieldDefinition?  @relation("CustomFieldRollupSource", fields: [rollupSourceFieldId], references: [id], onDelete: SetNull)
  rollupDependents  CustomFieldDefinition[] @relation("CustomFieldRollupSource")

  @@index([workspaceId])
  @@index([rollupSourceFieldId])
}

model ProjectCustomField {
  projectId String
  fieldId   String
  sortOrder Int @default(0)

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([projectId, fieldId])
  @@index([projectId])
  @@index([fieldId])
}

model CustomFieldValue {
  id       String @id @default(cuid())
  taskId   String
  fieldId  String
  value    Json

  task     Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
  @@index([taskId])
  @@index([fieldId])
}

// ─── PORTFOLIO ────────────────────────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       PortfolioItem[]

  @@index([workspaceId])
}

model PortfolioItem {
  portfolioId String
  projectId   String
  sortOrder   Int    @default(0)
  addedAt     DateTime @default(now())

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([portfolioId, projectId])
  @@index([portfolioId])
  @@index([projectId])
}

// ─── GOALS ────────────────────────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  workspaceId String
  ownerId     String?
  name        String
  description String?
  status      GoalStatus @default(NO_STATUS)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User?         @relation(fields: [ownerId], references: [id])
  metrics     GoalMetric[]

  @@index([workspaceId])
  @@index([ownerId])
}

model GoalMetric {
  id         String         @id @default(cuid())
  goalId     String
  name       String
  type       GoalMetricType @default(PERCENT)
  current    Float          @default(0)
  target     Float          @default(100)
  unit       String?
  /// JSON metric definition (TASK_COUNT, CUSTOM_FIELD_SUM, EPIC_CHILDREN_PERCENT). Null = manual current only.
  definition Json?
  lastComputedAt DateTime?
  lastError      String?
  updatedAt  DateTime       @updatedAt

  goal       Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// ─── AUTOMATION ───────────────────────────────────────────────────────────────

model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  isActive    Boolean  @default(true)
  triggerType AutomationTriggerType
  triggerConfig Json
  actions     AutomationAction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String
  actionType   AutomationActionType
  actionConfig Json
  sortOrder    Int                  @default(0)

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String
  body        String?
  resourceId  String?
  resourceType String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient   User  @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User? @relation("NotifSender", fields: [senderId], references: [id])

  @@index([recipientId, isRead])
  @@index([createdAt])
}

// ─── ACTIVITY LOG ─────────────────────────────────────────────────────────────

model ActivityLog {
  id           String   @id @default(cuid())
  projectId    String?
  taskId       String?
  actorId      String
  eventType    AuditEventType
  description  String
  oldValue     Json?
  newValue     Json?
  createdAt    DateTime @default(now())

  project      Project? @relation(fields: [projectId], references: [id])
  task         Task?    @relation(fields: [taskId], references: [id])
  actor        User     @relation(fields: [actorId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String         @id @default(cuid())
  workspaceId  String
  taskId       String?
  actorId      String?
  actorTier    ActorTier?
  eventType    AuditEventType
  description  String
  metadata     Json?
  createdAt    DateTime       @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  task         Task?     @relation(fields: [taskId], references: [id])
  actor        User?     @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([taskId])
  @@index([actorTier])
  @@index([createdAt])
}

// ─── AGENT AUTH ───────────────────────────────────────────────────────────────

model AgentToken {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?
  name        String
  token       String           @unique
  scope       AgentTokenScope[]
  actorTier   ActorTier
  isActive    Boolean          @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([workspaceId])
}

// ─── MODELT PM (Section 5.2) — tables: projects, tasks, … (not product Project/Task) ─

model PmProject {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  name            String
  status          String   @default("PHASE_0")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  ideaBriefPath   String?  @map("idea_brief_path")
  planPath        String?  @map("plan_path")
  designDocPath   String?  @map("design_doc_path")
  repoUrl         String?  @map("repo_url")
  metadata        Json     @default("{}") @db.JsonB

  pmTasks         PmTask[]
  pmHumanGates    PmHumanGate[]
  pmAuditLogs     PmAuditLog[]
  pmRagLogs       PmRagIngestionLog[]

  @@map("projects")
}

model PmTask {
  id                   String    @id
  projectId            String    @map("project_id") @db.Uuid
  phase                Int
  implementationPhase  String?   @map("implementation_phase")
  title                String
  description          String
  actorTier            String    @map("actor_tier")
  domain               String
  complexity           String
  estimatedMinutes     Int       @default(60) @map("estimated_minutes")
  timeoutMinutes       Int       @default(60) @map("timeout_minutes")
  parallelGroup        String?   @map("parallel_group")
  status               String    @default("PENDING")
  priority             Int       @default(3)
  reviewGate           String    @default("AUTOMATED_ONLY") @map("review_gate")
  acceptanceCriteria   Json      @default("[]") @map("acceptance_criteria") @db.JsonB
  contextRefs          Json      @default("[]") @map("context_refs") @db.JsonB
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  project              PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies         PmTaskDependency[] @relation("PmTaskDependencyFrom")
  dependents           PmTaskDependency[] @relation("PmTaskDependencyTo")
  artifacts            PmTaskArtifact[]
  runs                 PmTaskRun[]
  originatingGates     PmHumanGate[] @relation("PmHumanGateOriginating")
  blockingGates        PmHumanGate[] @relation("PmHumanGateBlocking")
  pmAuditLogs          PmAuditLog[]

  @@index([projectId, status])
  @@index([actorTier])
  @@index([projectId, phase])
  @@map("tasks")
}

model PmTaskDependency {
  taskId      String @map("task_id")
  dependsOnId String @map("depends_on_id")

  task      PmTask @relation("PmTaskDependencyFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn PmTask @relation("PmTaskDependencyTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model PmTaskArtifact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String   @map("task_id")
  artifactType String   @map("artifact_type")
  name         String
  path         String?
  url          String?
  content      String?
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  task PmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_artifacts")
}

model PmTaskRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String    @map("task_id")
  runNumber      Int       @map("run_number")
  actorTier      String    @map("actor_tier")
  actorDetail    String?   @map("actor_detail")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  outcome        String?
  failureReason  String?   @map("failure_reason")
  outputSummary  String?   @map("output_summary")
  artifactIds    Json      @default("[]") @map("artifact_ids") @db.JsonB

  task PmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, runNumber])
  @@map("task_runs")
}

model PmHumanGate {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  gateType            String    @map("gate_type")
  originatingTaskId   String?   @map("originating_task_id")
  blockingTaskId      String?   @map("blocking_task_id")
  contextSummary      String    @map("context_summary")
  failureHistory      Json      @default("[]") @map("failure_history") @db.JsonB
  decisionOptions     Json      @map("decision_options") @db.JsonB
  recommendedOption   String?   @map("recommended_option")
  decision            String?
  decisionNotes       String?   @map("decision_notes")
  status              String    @default("PENDING")
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")
  ageAlertSent        Boolean   @default(false) @map("age_alert_sent")

  project           PmProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originatingTask   PmTask?    @relation("PmHumanGateOriginating", fields: [originatingTaskId], references: [id], onDelete: SetNull)
  blockingTask      PmTask?    @relation("PmHumanGateBlocking", fields: [blockingTaskId], references: [id], onDelete: SetNull)
  pmAuditLogs       PmAuditLog[]

  @@index([projectId, status])
  @@map("human_gates")
}

model PmAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  taskId     String?  @map("task_id")
  gateId     String?  @map("gate_id") @db.Uuid
  eventType  String   @map("event_type")
  actor      String?
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  detail     Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  project PmProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    PmTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  gate    PmHumanGate? @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("audit_log")
}

model PmRagIngestionLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  sourcePath  String   @map("source_path")
  chunkCount  Int?     @map("chunk_count")
  collection  String
  ingestedAt  DateTime @default(now()) @map("ingested_at")
  contentHash String?  @map("content_hash")

  project PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("rag_ingestion_log")
}
